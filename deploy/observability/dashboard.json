{
  "uid": "acp-overview",
  "title": "Airspace Conformance Platform",
  "description": "Four questions an operator asks: is data flowing, is it keeping up, is the picture believable, is the model working. One row each.",
  "tags": ["acp"],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "acp-prometheus" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Is data flowing?",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Messages published per second, by topic",
      "description": "Counted inside the publisher, so it covers the feed as well -- the feed is a pure producer and has no other instrumentation.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(acp_messages_published_total[1m]))",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reports consumed vs track updates published",
      "description": "These two should track each other one for one. A gap means the tracker is dropping work, coasting, or wedged.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(acp_reports_consumed_total[1m]))",
          "legendFormat": "reports in"
        },
        {
          "refId": "B",
          "expr": "sum(rate(acp_track_updates_published_total[1m]))",
          "legendFormat": "updates out"
        }
      ]
    },
    {
      "type": "row",
      "title": "Is it keeping up?",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Report filter latency",
      "description": "One surveillance report through its Kalman filter. Excludes Kafka publication and database writes, which belong to the deployment. The red line is the 1 ms p95 in docs/latency-budget.md — at 500 aircraft this runs 500 times a second, so it is what decides whether the tracker scales. An earlier version of this panel drew the line at 1 s, a thousand times the budget it claimed to show.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(acp_report_filter_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(acp_report_filter_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(acp_report_filter_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer lag",
      "description": "Messages behind the head of the partition. A flat non-zero value is fine. A rising one is the difference between slow and failing.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, topic) (acp_consumer_lag_messages)",
          "legendFormat": "{{service}} / {{topic}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Conflict scan duration",
      "description": "Time to check every pair in the airspace picture. Grows with the square of the traffic count before the spatial grid prunes it, so this is the panel that shows the pruning working.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(acp_conflict_scan_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Messages discarded (contract violations)",
      "description": "A malformed message is skipped rather than retried forever. Any sustained non-zero rate here means a producer and a consumer disagree about the contract.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, topic) (rate(acp_messages_discarded_total[5m]))",
          "legendFormat": "{{service}} / {{topic}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Is the picture believable?",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Live tracks",
      "description": "Aircraft currently held, summed across tracker replicas. Each replica owns only the partitions Kafka assigned it, so this is a sum of partial pictures, not a maximum of them — an earlier version used max() and read roughly half the true count at the two replicas the manifests ship. Zero while the feed is running is a visible failure that no error log reports.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(acp_live_tracks{service=\"track\"})",
          "legendFormat": "tracks"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active alerts",
      "description": "Alerts the state machine currently believes are live -- NEW or SUSTAINED, not yet CLEARED.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "max(acp_active_alerts)",
          "legendFormat": "alerts"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Alert transitions per minute",
      "description": "Split by kind and lifecycle state. A high CLEARED rate relative to NEW means alerts are flapping and the hysteresis needs looking at.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, state) (increase(acp_alerts_published_total[1m]))",
          "legendFormat": "{{kind}} {{state}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Is the clever part working?",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Trajectory model loaded",
      "description": "0 means every prediction is dead reckoning. The system still works -- that is the point of residual learning -- but the ML component is doing nothing, and that is exactly the degradation that otherwise goes unnoticed for months.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 33 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "physics only", "color": "orange", "index": 0 },
                "1": { "text": "model loaded", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": { "graphMode": "none", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "max(acp_trajectory_model_loaded)",
          "legendFormat": "model"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Predictions by source",
      "description": "Which path produced each forecast. A silent, permanent slide towards the physics fallback is the failure this panel exists to catch.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 6, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (increase(acp_trajectory_predictions_total[15m]))",
          "legendFormat": "{{source}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Prediction rate by source",
      "description": "The same split over time, so a fallback that starts mid-run is visible as a step rather than as a shifted ratio.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 10, "x": 14, "y": 33 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (rate(acp_trajectory_predictions_total[1m]))",
          "legendFormat": "{{source}}"
        }
      ]
    }
  ]
}
